# Build output. Nothing built belongs in here: the obj/ folder alone carries the absolute path of the
# machine that built it and the URL of whatever repository it was built from.
bin/
obj/
dist/

# The packaged extension is a release asset, not a source file - tools/build.ps1 makes one.
*.vsix

# Yak packages, likewise built rather than kept.
*.yak

# Where somebody's own machine keeps its private package source. tools/pack-yak.ps1 has always said this
# was ignored and given the reason - a path with a person's name in it does not belong in a repository -
# but the rule was never written, so the file was tracked and the path published with it.
tools/yak-destination.txt

# A staging area for code on its way to a repository of its own. Ignored rather than tracked because this
# repository ships publicly, and what is waiting there is specific to one pipeline: an unfinished move is
# not a reason to publish it. See _relocate/README.md.
_relocate/

node_modules/

# Editors
.vs/
.vscode/
*.user
*.suo

# Rhino and Grasshopper leftovers
*.3dmbak
*.ghx.bak
