<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The bridge between a canvas and an agent. It references no Phenome library by design: the protocol it
    exposes is useful to any Grasshopper user with any agent, and a single self-contained .gha can be
    published on its own. When both are loaded, the kernel plugin adds to what this one reports, through
    reflection.
  -->
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>Phenome.Apps.GrasshopperLink</RootNamespace>
    <AssemblyName>Phenome.Apps.GrasshopperLink</AssemblyName>

    <!-- Kept in step with manifest.yml: Yak cross-checks the two and reports a mismatch. The friction log
         stamps its entries with this value, and a report names a build. -->
    <Version>0.36.0</Version>

    <!-- Without this the SDK appends the commit hash to the informational version, which is what Yak and the
         plugin both read as the version. That field is meant to hold a build number. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>

    <TargetExt>.gha</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.21.25188.17001" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    The shared code is compiled in as source. A self-contained .gha is the requirement, and a
    ProjectReference would add a third file that has to resolve at plugin-load time. Compiling the sources
    in gives one copy of the source and two copies of the IL, with nothing new to deploy. See the README there.
  -->
  <ItemGroup>
    <Compile Include="..\Phenome.Apps.Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
