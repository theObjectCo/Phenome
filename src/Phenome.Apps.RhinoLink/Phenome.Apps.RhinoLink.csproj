<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The half of the link that belongs to Rhino rather than to the canvas.

    A .gha exists only after Grasshopper starts, and Grasshopper starts by being opened. Anything before
    that is out of reach of the other plugin, including a dialog on startup, which blocks Rhino before any
    canvas exists, with nothing listening to report it.

    This plugin loads with Rhino and reports on the process: whether the UI thread is free, what is blocking
    it, and how to answer that. It references no Phenome library and not Grasshopper either.
  -->
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>Phenome.Apps.RhinoLink</RootNamespace>
    <AssemblyName>Phenome.Apps.RhinoLink</AssemblyName>

    <!-- What Rhino shows in PlugInManager. Without it the SDK defaults the assembly title to the assembly
         name, and a person sees "Phenome.Apps.RhinoLink". Yak reads the same name and reports the mismatch.
         The title matches the name the plugin already shows a person: OnLoad says "Phenome Rhino Link did
         not start". -->
    <Title>Phenome Rhino Link</Title>

    <Version>0.36.0</Version>

    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>

    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    The same shared source the canvas half compiles. Nothing there may use Grasshopper: this plugin answers
    about a dialog that appears before Grasshopper loads and cannot depend on it. See the README there.
  -->
  <ItemGroup>
    <Compile Include="..\Phenome.Apps.Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
