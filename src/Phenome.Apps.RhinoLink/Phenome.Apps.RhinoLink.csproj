<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The half of the link that belongs to Rhino rather than to the canvas.

    A .gha only exists once Grasshopper has been started, and Grasshopper is started by opening it - so
    everything that happens before that is out of reach of the other plugin. That includes the one thing
    an agent most needs a way out of: a dialog on startup, which holds Rhino before any canvas exists and
    leaves nothing listening to say so.

    This one loads with Rhino itself and answers about the process: whether the UI thread is free, what is
    blocking it, and how to answer that. It references no Phenome library and not Grasshopper either.
  -->
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>Phenome.Apps.RhinoLink</RootNamespace>
    <AssemblyName>Phenome.Apps.RhinoLink</AssemblyName>

    <!-- What Rhino shows in PlugInManager. Without it the SDK defaults the assembly title to the assembly
         name, so the human saw "Phenome.Apps.RhinoLink" - which is how Yak came to report the mismatch that
         led here, since it reads the same name. This is the name the plugin already gives itself when it
         speaks to a person: OnLoad says "Phenome Rhino Link did not start". -->
    <Title>Phenome Rhino Link</Title>

    <Version>0.23.0</Version>

    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>

    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    The same shared source the canvas half compiles in, which is why nothing there may touch Grasshopper:
    this plugin answers about a dialog that appears before Grasshopper has loaded, so it cannot be made to
    depend on it. See the README there.
  -->
  <ItemGroup>
    <Compile Include="..\Phenome.Apps.Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
